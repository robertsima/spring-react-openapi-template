{
  "name": "your_repo_name-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "generate:api": "openapi-generator-cli generate -i ../openapi/openapi.yaml -g typescript-fetch -o src/generated/api --additional-properties=supportsES6=true",
    "dev": "npm run generate:api && vite",
    "build": "tsc -b && vite build",
    "build:full": "npm run generate:api && npm run build",
    "lint": "eslint .",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/material": "^6.0.2",
    "@stomp/stompjs": "^6.1.2",
    "oidc-client-ts": "^3.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "4.3.1",
    "react-oidc-context": "^3.2.0",
    "react-router": "^6.26.1",
    "react-router-dom": "^6.26.1",
    "react-stomp-hooks": "^2.1.0",
    "sockjs-client": "^1.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@openapitools/openapi-generator-cli": "^2.13.4",
    "@storybook/addon-a11y": "^8.2.9",
    "@storybook/addon-essentials": "^8.2.9",
    "@storybook/addon-interactions": "^8.2.9",
    "@storybook/react": "^8.2.9",
    "@storybook/react-vite": "^8.2.9",
    "@storybook/test": "^8.2.9",
    "@types/node": "^22.5.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/sockjs-client": "^1.5.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "sass-embedded": "^1.82.0",
    "storybook": "^8.2.9",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.1"
  }
}
