# Copy to .env (git-ignored). Used by the VS Code launch config to run the backend locally.

# One DB profile (sqlserver | oracle) + one auth profile (waffle | kerberos | localdev)
SPRING_PROFILES_ACTIVE=sqlserver,localdev

# SQL Server (deploy/podman-kube-sqlserver.yaml exposes 1433)
SPRING_DATASOURCE_URL=jdbc:sqlserver://localhost:1433;databaseName=appdb;encrypt=true;trustServerCertificate=true
# Oracle (deploy/podman-kube-oracle.yaml exposes 1521)
# SPRING_DATASOURCE_URL=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
SPRING_DATASOURCE_USERNAME=appuser
SPRING_DATASOURCE_PASSWORD=AppPassw0rd!

# kerberos profile only
# KERBEROS_SERVICE_PRINCIPAL=HTTP/app.mydomain.com@MYDOMAIN.COM
# KERBEROS_KEYTAB=/etc/krb5/app.keytab
