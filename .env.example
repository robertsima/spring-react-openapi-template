# Copy to .env (git-ignored). Used by the VS Code launch config to run the backend locally.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/appdb
SPRING_DATASOURCE_USERNAME=appuser
SPRING_DATASOURCE_PASSWORD=apppassword

# Local Keycloak started from keycloak/your-realm.json (see README)
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8180
KEYCLOAK_REALM=your-realm
